# Copy to .env (git-ignored) and adjust. All values here are DEMO-ONLY.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
# Change if 5432 is already taken on your machine
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/pokemon
DB_USERNAME=pokemon
DB_PASSWORD=pokemon

# --- Security (ADR-008) ---
# JWT signing secret, at least 32 bytes. Leave empty for a random key per start (tokens do not survive a restart).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime (Spring duration format)
JWT_TTL=1h
