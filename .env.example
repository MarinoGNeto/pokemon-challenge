# Optional: copy to .env (git-ignored) and adjust. `docker compose up --build` works without it.
# All values here are DEMO-ONLY.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
# Change if 5432 is already taken on your machine
POSTGRES_PORT=5432

# --- Published ports (docker-compose) ---
# App: http://localhost:3000 · API and Swagger UI: http://localhost:8080
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Backend run outside Docker (./mvnw spring-boot:run) ---
# Inside docker-compose the backend connects to the postgres service using the POSTGRES_* values above.
DB_URL=jdbc:postgresql://localhost:5432/pokemon
DB_USERNAME=pokemon
DB_PASSWORD=pokemon

# --- Security (ADR-008) ---
# JWT signing secret, at least 32 bytes. Leave empty for a random key per start (tokens do not survive a restart).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime (Spring duration format)
JWT_TTL=1h
